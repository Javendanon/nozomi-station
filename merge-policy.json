{
  "version": 1,
  "mode": "enforce",
  "gates": [
    { "name": "elixir-deps", "cmd": "mix deps.get", "timeout_s": 900 },
    { "name": "elixir-db", "cmd": "MIX_ENV=test mix ecto.create --quiet || true", "timeout_s": 180 },
    { "name": "elixir-compile", "cmd": "MIX_ENV=test mix compile --warnings-as-errors", "timeout_s": 900 },
    { "name": "elixir-format", "cmd": "mix format --check-formatted", "timeout_s": 180 },
    { "name": "elixir-test", "cmd": "MIX_ENV=test mix test", "timeout_s": 1200 },
    { "name": "assets-npm-ci", "cmd": "npm ci --prefix assets", "timeout_s": 600 },
    { "name": "assets-node-test", "cmd": "npm --prefix assets test", "timeout_s": 600 }
  ],
  "never_paths": [
    ".github/**",
    "merge-policy.json",
    "CODEOWNERS",
    "**/migrations/**",
    "**/auth/**",
    "**/*secret*",
    "**/*.lock",
    "pnpm-lock.yaml",
    "package-lock.json",
    "assets/package.json",
    "mix.exs",
    "mix.lock",
    "compose.yaml",
    "config/runtime.exs",
    "config/prod.exs",
    ".env*"
  ],
  "max_review_lines": 600,
  "t0_max_lines": 60,
  "t0_max_files": 5
}
